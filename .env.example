# precog configuration — copy to .env (which is gitignored) and fill in.

# The reasoning engine. DeepSeek's Anthropic-compatible endpoint by default.
DEEPSEEK_API_KEY=

# The bot people reach you through. Create one with @BotFather.
TELEGRAM_BOT_TOKEN=

# id -> name. The keys ARE the allowlist: unlisted senders are dropped, and an
# empty dict admits no one. ONE dict serves both directions, so the name it
# hears in "[Chase · 15:04]" is the name it types in TelegramOut's `to`.
# Get your id by messaging @userinfobot.
TELEGRAM_PEOPLE={"123456789": "Chase"}
